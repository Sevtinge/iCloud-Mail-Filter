ICLOUD_EMAIL=yourname@icloud.com
ICLOUD_PASSWORD=your-app-specific-password

SOURCE_FOLDER=INBOX
TARGET_FOLDER=Mail/Test

# 在主题、正文和 HTML 正文中匹配；设置为 null/留空则禁用此条件
MATCH_TEXT=test

# 在发件人地址或显示名中匹配；设置为 null/留空则不按发件人过滤
MATCH_FROM=null

# 300 = 5 分钟
CHECK_INTERVAL=300

# 首次运行只检查最近 24 小时
FIRST_RUN_HOURS=24

# 每次最多处理 50 封候选邮件
MAX_PER_RUN=50

# IMAP 连接超时时间（秒）
IMAP_TIMEOUT=30
