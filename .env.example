ICLOUD_EMAIL=yourname@icloud.com
ICLOUD_PASSWORD=your-app-specific-password

SOURCE_FOLDER=INBOX
TARGET_FOLDER=Mail/Test

# Match the subject, plain-text body, and HTML body; use null or leave empty to disable this filter
MATCH_TEXT=test

# Match the sender address or display name; use null or leave empty to disable this filter
MATCH_FROM=null

# Docker restart policy: unless-stopped, always, on-failure, or no
RESTART_POLICY=unless-stopped

# 300 seconds = 5 minutes
CHECK_INTERVAL=300

# The first run only checks the last 24 hours
FIRST_RUN_HOURS=24

# Process at most 50 candidate messages per run
MAX_PER_RUN=50

# IMAP connection timeout in seconds
IMAP_TIMEOUT=30
